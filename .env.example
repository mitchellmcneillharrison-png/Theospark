# Theospark API configuration.
# These are SERVER-SIDE only (used by the Vercel function in api/chat.js) —
# they are never exposed to the browser, so no VITE_ prefix.
# Locally: copy to .env.local and run `vercel dev`.
# On Vercel: set these under Settings -> Environment Variables.
THEOSPARK_API_URL=
THEOSPARK_API_KEY=
